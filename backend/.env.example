# Knowledge data platform API
APP_ENV=development
CORS_ALLOW_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000

# This project's own PostgreSQL database stores users and the virtual document directory.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/knowledge_platform
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
# Concurrent document workers for the PostgreSQL-backed embedding queue (1-16).
KNOWLEDGE_EMBEDDING_WORKERS=3
KNOWLEDGE_START_EMBEDDING_WORKER=1

# The backend calls Identity Center server-to-server. Never expose this URL or cookies in logs.
IDENTITY_CENTER_BASE_URL=http://127.0.0.1:8002

# Knowledge owns an HttpOnly, host-only relay cookie; it contains the Identity Center opaque value.
# Keep SameSite=Lax for local development; use Secure=true behind production HTTPS.
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false

# Gateway HTTP API and collection. Users add their own project API Key in Knowledge Settings.
GATEWAY_BASE_URL=http://127.0.0.1:8000/v1
GATEWAY_COLLECTION=shared-knowledge
# Vector API-specific configuration takes precedence over the legacy values above.
# Accepts the service root or a complete /gateway/v1 prefix.
GATEWAY_VECTOR_BASE_URL=http://127.0.0.1:8000
GATEWAY_VECTOR_COLLECTION=shared-knowledge
# Used by standalone/server-side clients; web operations still require the user's saved Key.
GATEWAY_VECTOR_API_KEY=
GATEWAY_EMBEDDING_MODEL=openai/text-embedding-3-small
# Server-side key for authenticated users' own Context data. If omitted, the user's saved Key is used.
GATEWAY_CONTEXT_API_KEY=
# Required to encrypt user Gateway keys in this project's database. Generate with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GATEWAY_CREDENTIAL_ENCRYPTION_KEY=replace-with-generated-fernet-key

# 交互式知识库使用用户在设置中选择的集合；GATEWAY_VECTOR_COLLECTION 仅保留给旧工具/直接 SDK 装配。
