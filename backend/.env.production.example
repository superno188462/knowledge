APP_ENV=production
HOST=0.0.0.0
PORT=8001
# Exact browser Origin values, including scheme and port, without a trailing slash.
CORS_ALLOW_ORIGINS=https://knowledge.example.com

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@DB_HOST:5432/knowledge_platform
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Private HTTPS endpoint reachable only from the Knowledge backend.
IDENTITY_CENTER_BASE_URL=https://identity.example.com
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=true

GATEWAY_BASE_URL=https://gateway.example.com/v1
GATEWAY_COLLECTION=shared-knowledge
GATEWAY_VECTOR_BASE_URL=https://gateway.example.com/gateway/v1
GATEWAY_VECTOR_COLLECTION=shared-knowledge
GATEWAY_VECTOR_API_KEY=
GATEWAY_EMBEDDING_MODEL=openai/text-embedding-3-small
# Server-side project key for users' own context data; never expose it to the browser.
GATEWAY_CONTEXT_API_KEY=replace-with-server-side-context-key
GATEWAY_CREDENTIAL_ENCRYPTION_KEY=replace-with-generated-fernet-key
