# 复制为 deploy/.env，所有部署命令都传 --env-file deploy/.env。
KNOWLEDGE_IMAGE_TAG=local
# 默认仅宿主机可访问，由宿主机 Nginx/Caddy 提供 HTTPS。
KNOWLEDGE_BIND_ADDRESS=127.0.0.1
KNOWLEDGE_HTTP_PORT=3000
POSTGRES_DB=knowledge
POSTGRES_USER=knowledge
# 使用随机十六进制密码，避免 DATABASE_URL 中的保留字符。
POSTGRES_PASSWORD=replace-with-generated-hex-password

APP_ENV=production
CORS_ALLOW_ORIGINS=https://knowledge.example.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# 必须是容器内可以访问的 URL；localhost 指向容器自身。
IDENTITY_CENTER_BASE_URL=https://identity.example.com
GATEWAY_BASE_URL=https://gateway.example.com/gateway/v1
GATEWAY_VECTOR_BASE_URL=https://gateway.example.com/gateway/v1
# 用户在页面中选择集合，无需设置固定 collection。
GATEWAY_EMBEDDING_MODEL=volc/doubao-embedding-vision
# 知识库 Key 仍由用户在设置中提交，不自动用全局 Key 绕过用户权限。
GATEWAY_VECTOR_API_KEY=
GATEWAY_CONTEXT_API_KEY=replace-with-context-service-key
# 从已有部署迁移时，必须保留原加密密钥才能解密已保存的用户 Key。
GATEWAY_CREDENTIAL_ENCRYPTION_KEY=replace-with-fernet-key
KNOWLEDGE_START_EMBEDDING_WORKER=1
KNOWLEDGE_EMBEDDING_WORKERS=3
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
